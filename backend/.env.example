# Copy to backend/.env for local dev (never commit .env).
# Provider keys — leave blank and the admin panel shows the provider as "not connected".
API_FOOTBALL_KEY=
ODDS_API_KEY=

# Season passed to API-Football (2026 = the 2026/27 European season, MLS 2026).
FOOTBALL_SEASON=2026
# Seconds between API-Football calls. Free plan allows 10/minute, so 6.5 is safe.
# Drop to ~0.2 on a paid plan.
API_FOOTBALL_MIN_INTERVAL=6.5

# Accounts: comma-separated usernames; each gets PASSWORD_<USERNAME> (defaults to "changeme").
USERS=sam,ivo
PASSWORD_SAM=changeme
PASSWORD_IVO=changeme
JWT_SECRET=dev-only-secret

CORS_ORIGINS=*
